.DS_Store
.idea/
*.swp

# Tooling caches
.eslintcache
.vitest/
.turbo/

# Test report consumed by the no-skipped-tests gate
.vitest-report.json
.diagnostics/

# Agent worktrees and local session state. Never committed: these are
# unmerged working copies, not project history.
.claude/

# Local Phase 3 acceptance evidence
.phase3-acceptance-report.json
.phase4-acceptance-report.json

# Local source archive used during the Phase 4 merge. It is not part of the
# runnable workspace and repository-wide tools must never traverse it.
acalys-review-phase4-final-source/

