# Dependencies
node_modules/

# Build output
dist/
build/
coverage/
*.tsbuildinfo
.vite/

# Environment / secrets
.env
.env.*
!.env.example
*.pem

# Probe transcripts. Redacted on the way in, but they are raw provider
