{
  "name": "@acalys/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Canonical Acalys Review contracts: provider-neutral, persistence-neutral, runtime-validated.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "default": "./dist/domain/index.js"
    },
    "./api/v1": {
      "types": "./dist/api/v1/index.d.ts",
      "default": "./dist/api/v1/index.js"
    },
    "./internal": {
      "types": "./dist/internal/index.d.ts",
      "default": "./dist/internal/index.js"
    },
    "./dashboard/v1": {
      "types": "./dist/dashboard/v1/index.d.ts",
      "default": "./dist/dashboard/v1/index.js"
    }
  },
  "files": [
    "dist",
    "generated"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "schemas:generate": "tsx scripts/generate-schemas.ts",
    "schemas:check": "tsx scripts/generate-schemas.ts --check"
  },
  "dependencies": {
    "uuidv7": "^1.0.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "tsx": "^4.23.12"
  }
}
