{
  "name": "@acalys/review-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Analyzers. What turns supplied context into candidate findings.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eval": {
      "types": "./dist/eval/index.d.ts",
      "default": "./dist/eval/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "eval:dashboard": "tsx scripts/dashboard.ts",
    "eval:funnel": "tsx scripts/funnel-dashboard.ts",
    "eval:verifier": "tsx scripts/verifier-dashboard.ts",
    "eval:baseline": "tsx scripts/baseline-report.ts"
  },
  "dependencies": {
    "@acalys/code-intelligence": "*",
    "@acalys/contracts": "*",
    "typescript": "^5.9.3",
    "@acalys/model-gateway": "*",
    "zod": "^4.1.13"
  }
}
