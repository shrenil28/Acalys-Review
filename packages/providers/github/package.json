{
  "name": "@acalys/provider-github",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "GitHub adapter: webhook verification and normalization to canonical Acalys contracts. The only place GitHub's vocabulary is understood.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@acalys/contracts": "*",
    "zod": "^4.1.13"
  }
}
