{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    // Typechecking resolves @acalys/contracts to source so a contract change is
    // caught here immediately. Emit uses tsconfig.build.json, which clears this
    // and resolves through the package's own exports.
    "paths": {
      "@acalys/contracts": ["../contracts/src/index.ts"],
      "@acalys/contracts/domain": ["../contracts/src/domain/index.ts"],
      "@acalys/contracts/api/v1": ["../contracts/src/api/v1/index.ts"],
      "@acalys/contracts/internal": ["../contracts/src/internal/index.ts"]
    }
  },
  "include": ["src", "tests"]
}
