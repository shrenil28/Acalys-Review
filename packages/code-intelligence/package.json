{
  "name": "@acalys/code-intelligence",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Symbols, references and the changed-symbol graph. What the context planner selects from.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./eval": {
      "types": "./dist/eval/index.d.ts",
      "default": "./dist/eval/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "eval:baseline": "tsx scripts/write-baseline.ts"
  },
  "dependencies": {
    "@acalys/contracts": "*",
    "typescript": "^5.9.3"
  }
}
