{
  "name": "@acalys/review-worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Claims stored deliveries and turns them into review history. Idempotent by construction: a crash produces another attempt, never another ReviewRun.",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@acalys/contracts": "*",
    "@acalys/database": "*",
    "@acalys/provider-github": "*",
    "zod": "^4.1.13",
    "@acalys/review-engine": "*",
    "@acalys/code-intelligence": "*"
  },
  "devDependencies": {
    "@acalys/webhook-gateway": "*",
    "supertest": "^7.1.1",
    "@types/supertest": "^6.0.2"
  }
}
