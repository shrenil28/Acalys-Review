{
  "name": "@acalys/webhook-gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Provider webhook ingress. Authenticates exact bytes, durably owns each delivery exactly once, acknowledges, and processes asynchronously.",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
