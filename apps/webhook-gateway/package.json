    "start": "node dist/main.js"
  },
  "dependencies": {
    "@acalys/contracts": "*",
    "@acalys/database": "*",
    "@acalys/provider-github": "*",
    "express": "^5.1.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "supertest": "^7.1.1",
    "@types/supertest": "^6.0.2"
  }
}
