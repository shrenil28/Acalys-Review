{
  "name": "acalys",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Acalys Review — cloud code-review platform",
  "workspaces": [
    "apps/*",
    "packages/*",
    "packages/providers/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "node scripts/run-gate.mjs typecheck -- npm run typecheck:projects",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:l5": "npm run build --workspace=@acalys/contracts && npm run build --workspace=@acalys/code-intelligence && npm run build --workspace=@acalys/review-engine && tsx apps/review-worker/src/eval/run-l5-report.ts",
    "lint": "node scripts/run-gate.mjs lint -- eslint .",
    "format": "prettier --write .",
    "format:check": "node scripts/run-gate.mjs format:check -- prettier --check .",
    "depcruise": "node scripts/run-gate.mjs depcruise -- depcruise apps packages --config .dependency-cruiser.cjs",
    "schemas:generate": "npm run schemas:generate --workspace @acalys/contracts",
    "schemas:check": "node scripts/run-gate.mjs schemas:check -- npm run schemas:check --workspace @acalys/contracts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run depcruise && npm run references && npm run schemas:check && npm run build:clean && npm run export-conformance && npm run test:ci",
    "build:clean": "node scripts/run-gate.mjs build:clean -- node scripts/assert-clean-build.mjs",
    "test:ci": "node scripts/run-gate.mjs test:ci -- node scripts/test-ci.mjs",
    "references": "node scripts/run-gate.mjs references -- node scripts/assert-project-references.mjs",
    "export-conformance": "node scripts/run-gate.mjs export-conformance -- node scripts/assert-export-conformance.mjs",
    "typecheck:projects": "npm run typecheck --workspaces --if-present && tsc -p scripts/tsconfig.json",
    "mutate:phase3": "node scripts/mutate-phase3.mjs",
    "probe:phase3-architecture": "node scripts/probe-phase3-architecture.mjs",
    "probe:phase3-tenant-graph": "node scripts/probe-phase3-tenant-graph.mjs",
    "probe:phase3-rate-limit": "node scripts/probe-phase3-rate-limit.mjs",
    "probe:phase3-error-boundary": "node scripts/probe-phase3-error-boundary.mjs",
    "probe:phase3-auth-clock": "node scripts/probe-phase3-auth-clock.mjs",
    "probe:phase3-mutation-clock": "node scripts/probe-phase3-mutation-clock.mjs",
    "probe:phase3-oauth-commit": "node scripts/probe-phase3-oauth-commit.mjs",
    "probe:phase3-dispatch-coordination": "node scripts/probe-phase3-dispatch-coordination.mjs",
    "probe:phase3-sse-liveness": "node scripts/probe-phase3-sse-liveness.mjs",
    "probe:phase3-pagination-cursor": "node scripts/probe-phase3-pagination-cursor.mjs",
    "probe:phase3-handler-status": "node scripts/probe-phase3-handler-status.mjs",
    "probe:phase3-check-page-bound": "node scripts/probe-phase3-check-page-bound.mjs",
    "probe:phase3-query-boundary": "node scripts/probe-phase3-query-boundary.mjs",
    "phase3:source-invariants": "node scripts/assert-phase3-source-invariants.mjs",
    "accept:phase3:preflight": "node scripts/accept-phase3.mjs --preflight-only",
    "accept:phase3": "node scripts/accept-phase3.mjs",
    "probe:phase4-live-foundation": "node scripts/probe-phase4-live-foundation.mjs",
    "probe:phase4-review-workflow": "node scripts/probe-phase4-review-workflow.mjs",
    "probe:phase4-dashboard-admin": "node scripts/probe-phase4-dashboard-admin.mjs",
    "probe:phase4-fixture-firewall": "node scripts/probe-phase4-fixture-firewall.mjs",
    "probe:phase4-provider-context": "node scripts/probe-phase4-provider-context.mjs",
    "probe:phase4-review-policy": "node scripts/probe-phase4-review-policy.mjs",
    "probe:phase4-auth-membership": "node scripts/probe-phase4-auth-membership.mjs",
    "probe:phase4-analytics-reports": "node scripts/probe-phase4-analytics-reports.mjs",
    "probe:phase4-cache": "node scripts/probe-phase4-cache.mjs",
    "probe:phase4-notifications-repositories": "node scripts/probe-phase4-notifications-repositories.mjs",
    "probe:phase4-security": "node scripts/probe-phase4-security.mjs",
    "accept:phase4:preflight": "node scripts/accept-phase4.mjs --preflight-only",
    "accept:phase4": "node scripts/accept-phase4.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "dependency-cruiser": "^17.1.1",
    "eslint": "^9.39.1",
    "fast-check": "^4.4.0",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.11"
  }
}
