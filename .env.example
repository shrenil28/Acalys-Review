# Compose/database
POSTGRES_PASSWORD=replace-with-a-long-random-password
ACALYS_PUBLIC_API_URL=http://localhost:8080

# API
ACALYS_API_CURSOR_SECRET=replace-with-at-least-32-random-characters
ACALYS_API_CURSOR_PREVIOUS_SECRETS=
ACALYS_API_REQUESTS_PER_MINUTE=120
ACALYS_API_ORG_REQUESTS_PER_MINUTE=3000
ACALYS_DASHBOARD_ORGANIZATION_ID=00000000-0000-7000-8000-000000000001
ACALYS_DASHBOARD_WEB_ORIGIN=http://localhost:8082
ACALYS_DASHBOARD_COOKIE_SECURE=false

# One-time/idempotent initial organization-owner bootstrap
ACALYS_BOOTSTRAP_ORGANIZATION_ID=00000000-0000-7000-8000-000000000001
ACALYS_BOOTSTRAP_ORGANIZATION_SLUG=example
ACALYS_BOOTSTRAP_ORGANIZATION_NAME=Example Organization
ACALYS_BOOTSTRAP_OWNER_PROVIDER=github
ACALYS_BOOTSTRAP_OWNER_PROVIDER_USER_ID=replace-with-your-numeric-github-user-id
ACALYS_BOOTSTRAP_OWNER_EMAIL=
ACALYS_BOOTSTRAP_OWNER_DISPLAY_NAME=

# GitHub dashboard OAuth
ACALYS_GITHUB_OAUTH_CLIENT_ID=
ACALYS_GITHUB_OAUTH_CLIENT_SECRET=
ACALYS_GITHUB_OAUTH_STATE_SECRET=
# Example: http://localhost:8080/dashboard/v1/auth/github/callback
ACALYS_GITHUB_OAUTH_CALLBACK_URL=
ACALYS_GITHUB_APP_SLUG=

# GitLab dashboard OAuth
ACALYS_GITLAB_OAUTH_CLIENT_ID=
ACALYS_GITLAB_OAUTH_CLIENT_SECRET=
ACALYS_GITLAB_OAUTH_STATE_SECRET=
# Example: http://localhost:8080/dashboard/v1/auth/gitlab/callback
ACALYS_GITLAB_OAUTH_CALLBACK_URL=

# GitHub webhook gateway and repository access
GITHUB_WEBHOOK_SECRET=replace-with-at-least-32-high-entropy-characters
ACALYS_GITHUB_WEBHOOK_PREVIOUS_SECRETS=
ACALYS_GITHUB_WEBHOOK_ENDPOINT_ID=primary-github-app
ACALYS_TRUSTED_PROXIES=
ACALYS_PROXY_HOPS=1
GITHUB_APP_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY_PEM=

# Model runtime. Configure routes only for providers with a matching API key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ACALYS_MODEL_CONFIG_JSON={"routingPolicyVersion":"v1","routes":{"triage":{"provider":"openai","modelId":"replace-me","tier":"cheap","maxOutputTokens":2000,"promptCaching":false,"inputMicroUsdPerMillion":0,"outputMicroUsdPerMillion":0},"correctness":{"provider":"openai","modelId":"replace-me","tier":"strong","maxOutputTokens":4000,"promptCaching":false,"inputMicroUsdPerMillion":0,"outputMicroUsdPerMillion":0},"verification":{"provider":"openai","modelId":"replace-me","tier":"strong","maxOutputTokens":2000,"promptCaching":false,"inputMicroUsdPerMillion":0,"outputMicroUsdPerMillion":0},"summary":{"provider":"openai","modelId":"replace-me","tier":"cheap","maxOutputTokens":2000,"promptCaching":false,"inputMicroUsdPerMillion":0,"outputMicroUsdPerMillion":0}},"budget":{"maxCallsPerRun":20,"maxCostMicroUsdPerCall":1000000,"maxCostMicroUsdPerRun":5000000,"maxCostMicroUsdPerOrganization":50000000,"organizationWindowMs":86400000},"credentials":{"openai":{"credentialId":"openai-primary","maxConcurrency":8,"requestsPerMinute":120,"leaseMillis":30000},"anthropic":{"credentialId":"anthropic-primary","maxConcurrency":8,"requestsPerMinute":120,"leaseMillis":30000}},"retries":{"maxAttempts":3,"baseDelayMs":500,"maxDelayMs":5000}}
ACALYS_MODEL_REPLAY_MODE=off
ACALYS_MODEL_CASSETTE_PATH=
ACALYS_REVIEW_WORKER_BATCH_SIZE=10
ACALYS_REVIEW_WORKER_LEASE_MS=300000
ACALYS_REVIEW_WORKER_POLL_MS=1000
ACALYS_REVIEW_WORKER_RETRY_BACKOFF_MS=5000

# Optional encrypted integration configuration. Generate independent 32-byte
# keys and encode them as base64url.
ACALYS_INTEGRATION_CREDENTIAL_KEYS_JSON=
ACALYS_LINEAR_OAUTH_CLIENT_ID=
ACALYS_LINEAR_OAUTH_CALLBACK_URL=
